# Copy to .env.local and fill in. .env.local is ignored by git.

# 64 hex characters (32 bytes) used to encrypt Steam secrets and refresh tokens.
# Generated automatically on first start if missing. Keep a backup:
# losing it means every account has to enter its Steam password again.
SECRETS_KEY=""

# Server port (default 3000)
PORT=3000

# Listen address. Default is 127.0.0.1 in development and 0.0.0.0 in production.
# HOST="0.0.0.0"
