rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256;
    }

    // Plaintext Steam passwords / maFile secrets are never allowed in the database;
    // secrets live only in the server-encrypted `secrets` blob.
    function hasNoPlaintextSecrets(data) {
      return !('password' in data) && !('maFileData' in data);
    }

    function isValidSteamAccount(data) {
      return data.ownerUid is string && data.ownerUid == request.auth.uid &&
             data.accountName is string && data.accountName.size() <= 128 &&
             hasNoPlaintextSecrets(data) &&
             (!('secrets' in data) || (data.secrets is string && data.secrets.size() <= 8192));
    }

    function isValidProxy(data) {
      return data.url is string && data.url.size() <= 512 &&
             data.label is string && data.label.size() <= 128;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['lastActive', 'email', 'uid', 'createdAt', 'displayName'])
      );

      // Steam Accounts Rules
      match /steamAccounts/{accountId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSteamAccount(incoming());
        allow update: if isOwner(userId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().accountName == existing().accountName &&
          // Only removal is allowed for legacy plaintext fields
          hasNoPlaintextSecrets(incoming()) &&
          (!('secrets' in incoming()) || (incoming().secrets is string && incoming().secrets.size() <= 8192)) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'personaName', 'avatar', 'vacBanned', 'status', 'lastCheck', 'lastUpdate',
            'walletBalance', 'walletCurrency', 'steamId', 'proxy', 'automation',
            'vacBans', 'gameBans', 'daysSinceLastBan', 'tradeBanState', 'isLimitedAccount', 'communityBanned',
            'secrets', 'hasToken', 'tokenExpires', 'password', 'maFileData'
          ]);
        allow delete: if isOwner(userId);
      }

      // Logs Rules
      match /logs/{logId} {
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().ownerUid == request.auth.uid &&
          incoming().message is string && incoming().message.size() <= 2000;
      }

      // Proxy Rules
      match /proxies/{proxyId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProxy(incoming());
        allow update: if isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasAny(['status', 'lastUsed', 'deleted', 'label', 'url'])
        );
        allow delete: if isOwner(userId);
      }
    }
  }
}
